# URL pública canónica (con www si GoDaddy no admite CNAME en el dominio raíz)
SITE_URL=https://www.vendiendoarquitectura.com
# Hosts extra que pueden servir sin redirigir (p. ej. el dominio de prueba de Railway)
ALLOW_HOSTS=vendiendo-arquitectura.up.railway.app
# Railway define PORT automáticamente
NODE_ENV=production

# --- Asistente del libro ---
GEMINI_API_KEY=
# Clave AES de 32 bytes en base64 (la genera «npm run kb:build»)
KB_KEY=
# Clave HMAC para firmar el historial (32 caracteres o más)
CHAT_SECRET=
# CHAT_ENABLED=true
# GEMINI_MODEL=gemini-3.5-flash-lite
# GEMINI_FALLBACK_MODEL=gemini-3.1-flash-lite
# CHAT_DAILY_LIMIT=25
# CHAT_IP_DAILY_LIMIT=120
# CHAT_BURST_PER_MINUTE=6
# CHAT_GLOBAL_DAILY_LIMIT=3000
# CHAT_DAILY_TOKEN_BUDGET=30000000
# CHAT_MAX_CONCURRENT=12
# CHAT_MAX_MESSAGE_CHARS=600
# CLIENT_IP_HEADER=x-real-ip

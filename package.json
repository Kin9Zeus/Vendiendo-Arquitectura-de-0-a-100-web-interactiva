{
  "name": "vendiendo-arquitectura-web",
  "version": "1.0.0",
  "private": true,
  "description": "Sitio oficial del libro «Vendiendo arquitectura de 0 a 100» de Sebastián Arias Duque · Editorial UVA.",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && node scripts/precompress.mjs",
    "preview": "npm run build && node --env-file-if-exists=.env server.mjs",
    "start": "node --env-file-if-exists=.env server.mjs",
    "assets": "python -I scripts/build_assets.py",
    "kb:build": "python -W ignore scripts/kb_extract.py && node --env-file-if-exists=.env scripts/kb-build.mjs",
    "test": "node --test \"test/*.test.mjs\""
  },
  "dependencies": {
    "sirv": "3.0.2"
  },
  "devDependencies": {
    "@astrojs/sitemap": "3.7.4",
    "@fontsource/lora": "5.3.0",
    "@fontsource/poppins": "5.3.0",
    "astro": "7.3.8",
    "gsap": "3.15.0",
    "lenis": "1.3.26",
    "sharp": "0.35.5"
  },
  "author": "Kin9Zeus",
  "repository": {
    "type": "git",
    "url": "https://github.com/Kin9Zeus/Vendiendo-Arquitectura-de-0-a-100-web-interactiva.git"
  }
}

---
import { whatsappLink } from '../config/site';

const links = [
  { href: '/#manifiesto', label: 'El libro' },
  { href: '/#contenido', label: 'Contenido' },
  { href: '/#indice', label: 'Índice' },
  { href: '/#asistente', label: 'Pregúntale' },
  { href: '/#autor', label: 'Autor' },
  { href: '/#preguntas', label: 'Preguntas' },
];
---

<header class="nav" data-nav>
  <div class="wrap nav__inner">
    <a class="nav__brand" href="/" aria-label="Inicio · Vendiendo arquitectura de 0 a 100">
      <span class="logo-mask" aria-hidden="true"></span>
      <span>Vendiendo arquitectura<span class="sr-only"> de 0 a 100</span></span>
    </a>
    <nav aria-label="Principal">
      <ul class="nav__links">
        {links.map((l) => <li><a href={l.href} data-navlink>{l.label}</a></li>)}
      </ul>
    </nav>
    <a class="btn nav__cta" href={whatsappLink()} target="_blank" rel="noopener" data-magnetic>
      Quiero el libro
    </a>
    <button class="nav__toggle" type="button" aria-expanded="false" aria-controls="menu" data-menu-toggle>
      <span></span><span></span><span class="sr-only">Abrir menú</span>
    </button>
  </div>
</header>

<div class="menu" id="menu" data-menu>
  <nav aria-label="Menú móvil">
    <ol>
      {links.map((l) => <li><a href={l.href} data-menu-link>{l.label}</a></li>)}
    </ol>
  </nav>
  <div class="menu__foot">
    <a class="btn" href={whatsappLink()} target="_blank" rel="noopener">Quiero el libro</a>
    <span>Editorial UVA · Pereira, Colombia</span>
  </div>
</div>
